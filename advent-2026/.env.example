OPENALEX_API_KEY=
CONTACT_EMAIL=
EMBER_API_KEY=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
GFW_API_KEY=
# CESIUM_ION_TOKEN は Day06 で使わないことにした（CesiumJS に同梱の地図を使う。satellite-tracker-3d/README.md）
