NASA_API_KEY=
# Day08 のベクトル化（https://dash.voyageai.com/ で発行。最初の2億トークンは無料）
VOYAGE_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
XENO_CANTO_API_KEY=
